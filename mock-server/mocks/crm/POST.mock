HTTP/1.1 201 Created
Content-Type: application/json

{
  "id": "crm-{{randomInt 100 999}}",
  "company": "{{request.body.company}}",
  "contactPerson": "{{request.body.contactPerson}}",
  "contactEmail": "{{request.body.contactEmail}}",
  "status": "{{request.body.status}}",
  "dealValue": {{request.body.dealValue}},
  "notes": "{{request.body.notes}}",
  "lastContact": "{{now 'YYYY-MM-DD'}}",
  "followUpDate": "{{request.body.followUpDate}}",
  "mandatesOpen": 0,
  "message": "CRM record created successfully."
}
